{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{src/**,vercel/seed/**}",
      "excludeFiles": "{frontend/**,tests/**,training/**,docs/**,.venv/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "buildCommand": "true",
  "outputDirectory": "public"
}
