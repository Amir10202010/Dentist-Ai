# ---------------------------------------------------------------------------
# Dentist-AI configuration.
#
# Copy to `.env` and fill in. Nested settings use a double underscore:
#   DENTIST_AI__ML__BACKEND  ->  settings.ml.backend
#
# Generate a secret key:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------

# `local` relaxes cookie security so http://localhost works. Use `production`
# anywhere reachable from a network — it enforces HTTPS-only cookies and HSTS.
DENTIST_AI__ENVIRONMENT=local
DENTIST_AI__SECRET_KEY=change-me-generate-a-real-one-before-running-anywhere

# --- Database -------------------------------------------------------------
# Postgres (production):
#   DENTIST_AI__DATABASE__URL=postgresql+asyncpg://user:pass@localhost:5432/dentist_ai
# SQLite (zero-setup local development):
DENTIST_AI__DATABASE__URL=sqlite+aiosqlite:///./var/dentist_ai.sqlite3
DENTIST_AI__DATABASE__POOL_SIZE=10
DENTIST_AI__DATABASE__MAX_OVERFLOW=10
DENTIST_AI__DATABASE__ECHO=false

# --- Inference ------------------------------------------------------------
# `yolo`  — real model, needs `pip install -e ".[ml]"` and a weights file.
# `stub`  — deterministic fake detections; no torch, instant startup.
DENTIST_AI__ML__BACKEND=stub
DENTIST_AI__ML__WEIGHTS_PATH=models/best.pt
DENTIST_AI__ML__DEVICE=cpu
DENTIST_AI__ML__CONFIDENCE_THRESHOLD=0.25
DENTIST_AI__ML__IOU_THRESHOLD=0.45
DENTIST_AI__ML__MAX_DETECTIONS=300
DENTIST_AI__ML__WARM_UP_ON_STARTUP=true

# --- Storage --------------------------------------------------------------
# Radiographs live outside the static root and are served only to authorised
# members of the owning organisation.
DENTIST_AI__STORAGE__ROOT=var/storage
DENTIST_AI__STORAGE__MAX_UPLOAD_BYTES=25165824

# --- Security -------------------------------------------------------------
DENTIST_AI__SECURITY__SESSION_MAX_AGE_SECONDS=1209600
DENTIST_AI__SECURITY__LOGIN_RATE_LIMIT=10/5m
DENTIST_AI__SECURITY__REGISTER_RATE_LIMIT=5/1h
DENTIST_AI__SECURITY__UPLOAD_RATE_LIMIT=60/1h
DENTIST_AI__SECURITY__TRUSTED_HOSTS=["localhost","127.0.0.1"]

# --- Observability --------------------------------------------------------
# `console` for human-readable local logs, `json` for production ingestion.
DENTIST_AI__LOG_LEVEL=INFO
DENTIST_AI__LOG_FORMAT=console
